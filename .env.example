# LLM providers
OPENROUTER_API_KEY=

# Email connector (SMTP send + IMAP read) — names match company.json connectors.*.*Env
SMTP_PASS=

# Telegram bot (BotFather token) — put the REAL token here.
# In the UI "Bot token env var name" field, type only: TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
# Optional: Telegram setWebhook secret_token (header x-telegram-bot-api-secret-token)
TELEGRAM_WEBHOOK_SECRET=

# Inbound webhook secret — send as header x-connector-secret or ?secret=
WEBHOOK_SECRET=
