# LLM providers
OPENROUTER_API_KEY=

# Email connector (SMTP send + IMAP read) — names match company.json connectors.*.*Env
SMTP_PASS=

# Telegram bot (BotFather token) — typically routed to the chief
TELEGRAM_BOT_TOKEN=

# Inbound webhook secret — send as header x-connector-secret or ?secret=
WEBHOOK_SECRET=
