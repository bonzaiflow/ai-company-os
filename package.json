{
  "name": "ai-company-os",
  "version": "0.1.0",
  "description": "Agent-swarm orchestrator for small local models — plan with an LLM, launch a company of agents, watch them work.",
  "type": "module",
  "bin": {
    "ai-company-os": "dist/cli.js",
    "ai-company-os-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:ui": "node scripts/dev-ui.mjs",
    "smoke": "npm run build && node dist/smoke.js",
    "mcp": "npm run build && node dist/mcp.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.7.0"
  }
}
